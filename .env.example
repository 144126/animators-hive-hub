# Copy to .env for local dev. Never commit .env — it holds real credentials.
# Cloudflare Pages: set the same two variables in
# Dashboard → Pages → your project → Settings → Environment variables
# (set them for both Production and Preview).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
